---
import { existingCategories, labelFor } from "../lib/categories";

const cats = await existingCategories();
---

<header class="sticky top-0 z-50 border-b border-line bg-paper/95 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3">
    <a href="/" class="flex items-baseline gap-1 font-display text-2xl font-extrabold text-navy">
      AZ<span class="text-pink">Pet</span>Shop
    </a>
    <nav class="hidden gap-6 md:flex">
      {
        cats.map((c) => (
          <a href={`/blog/${c}`} class="text-sm font-bold text-navy hover:text-pink">
            {labelFor(c)}
          </a>
        ))
      }
    </nav>
    <div class="flex items-center gap-3">
      <form action="/busca/" method="get" role="search" class="hidden lg:block">
        <label for="header-q" class="sr-only">Buscar no blog</label>
        <input
          id="header-q"
          name="q"
          type="search"
          placeholder="Buscar artigos…"
          class="w-44 rounded-full border border-line bg-paper px-4 py-2 text-sm text-ink outline-none focus:border-pink"
        />
      </form>
      <a href="/busca/" aria-label="Buscar no blog" class="text-navy hover:text-pink lg:hidden">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" class="h-5 w-5" aria-hidden="true">
          <circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" />
        </svg>
      </a>
      <a
        href="https://loja.azpetshop.com.br"
        class="rounded-full bg-navy px-4 py-2 text-xs font-bold text-white hover:bg-navy-700"
      >
        Visitar a loja
      </a>
    </div>
  </div>
  {
    cats.length > 0 && (
      <nav class="flex gap-5 overflow-x-auto border-t border-line px-4 py-2 md:hidden">
        {cats.map((c) => (
          <a href={`/blog/${c}`} class="whitespace-nowrap text-sm font-bold text-navy">
            {labelFor(c)}
          </a>
        ))}
      </nav>
    )
  }
</header>
